---
import type { Page, PageOf } from '../content/schema';
import { articlesFor, formatDate } from '../lib/content';
interface Props {
  page: PageOf<'news'>;
  pages: Page[];
}
const { page, pages } = Astro.props;
---

<section class="page-heading">
  <h1>{page.title}</h1>
  <p>{page.intro}</p>
</section>
<div class="news-grid">
  {articlesFor(pages, page.lang).map((article) => (
    <a class="story-card" href={article.path}>
      <time datetime={article.published}>
        {formatDate(article.published, page.lang)}
      </time>
      <h2>{article.title}</h2>
    </a>
  ))}
</div>
