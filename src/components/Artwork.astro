---
import type { Language } from '../content/schema';
import site from '../data/site.json';
import { copy } from '../lib/content';
interface Props {
  lang: Language;
  variant?: 'panorama' | 'artwork' | 'article-art';
  lazy?: boolean;
}
const { lang, variant = 'artwork', lazy = true } = Astro.props;
---

<figure class={variant}>
  <img
    src={site.painting}
    alt={copy[lang].painting}
    width="1600"
    height="800"
    loading={lazy ? 'lazy' : 'eager'}
    decoding="async"
  />
</figure>
