{
  "name": "bihary-balassa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/site.test.mjs",
    "verify": "npm run format:check && npm run check && npm run build && npm test",
    "hosting:serve": "firebase emulators:start --only hosting --project demo-biharybalassa",
    "hosting:test": "firebase emulators:exec --only hosting --project demo-biharybalassa \"node --test tests/hosting.test.mjs\"",
    "deploy": "DEPLOY_ENV=production npm run build && firebase deploy --only hosting",
    "deploy:preview": "DEPLOY_ENV=preview INDEX_SITE=false npm run build && firebase hosting:channel:deploy review --expires 7d"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "astro": "7.4.13",
    "oxc-transform-react": "^0.156.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "firebase-tools": "15.37.0",
    "parse5": "^8.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3"
  }
}
